# Copy to .env and fill in. .env is git-ignored.
# PROVIDER: "opensource" (Playwright + local tools) or "tinyfish" (TinyFish APIs)
PROVIDER=opensource
TINYFISH_API_KEY=
GEMINI_API_KEY=
PARDARSHI_DATA_DIR=./data
DEMO_SHOP_URL=http://127.0.0.1:8100

# Hosts the auditor may visit besides the demo shop (comma-separated). Only add sites you are allowed to test.
ALLOWED_HOSTS=127.0.0.1,localhost,www.demoblaze.com,demoblaze.com,bummer.in,www.bummer.in,fardaclothing.com,www.fardaclothing.com,www.decathlon.in,decathlon.in

# Where real-site audits on this machine are seen from (shopper language + timezone). TinyFish runs keep US.
HOME_COUNTRY=IN
